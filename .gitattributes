# Auto detect text files and perform LF normalization
* text=auto

# ==============================================================================
# Git LFS (Large File Storage) Configuration for Unity iOS UaaL & Flutter Assets
# Prevents GitHub 100MB file push rejection
# ==============================================================================

# Unity Serialized Data & Asset Bundles
*.assets filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text
*.resource filter=lfs diff=lfs merge=lfs -text
*.resS filter=lfs diff=lfs merge=lfs -text
*.ress filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
*.unityweb filter=lfs diff=lfs merge=lfs -text

# Native Precompiled Libraries & Static Archives
*.a filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.framework filter=lfs diff=lfs merge=lfs -text
*.xcframework filter=lfs diff=lfs merge=lfs -text

# Debug Symbols
*.dSYM filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text

# Large Media (Audio / Video / 3D)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text

# Compressed Archives
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

# Explicit UaaL iOS UnityLibrary Target Mapping
ios/UnityLibrary/**/Data/* filter=lfs diff=lfs merge=lfs -text
ios/UnityLibrary/**/*.a filter=lfs diff=lfs merge=lfs -text
ios/UnityLibrary/**/*.dylib filter=lfs diff=lfs merge=lfs -text
ios/UnityLibrary/**/*.dat filter=lfs diff=lfs merge=lfs -text
ios/UnityLibrary/**/*.assets filter=lfs diff=lfs merge=lfs -text
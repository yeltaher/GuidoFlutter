# Set minimum platform version for Guido Companion App (Flutter + WebXR)
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# On CI (Appcircle, etc.), map Debug to :release so CocoaPods links against the Release AOT Flutter engine,
# preventing JIT crash on iOS 14+ devices without a debugger attached.
is_ci_build = ENV['CI'] == 'true' || ENV['AC_APPCIRCLE'] == 'true' || !ENV['APPCIRCLE'].nil?

project 'Runner', {
  'Debug' => is_ci_build ? :release : :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

pre_install do |installer|
  puts '[Podfile] Ensuring Git LFS binary assets are pulled...'
  system('git lfs pull')

  if is_ci_build
    puts '[Podfile] CI detected: Ensuring iOS Release engine artifacts are precached...'
    system('flutter precache --ios')

    # Bulletproof CI safeguard: synchronize Release AOT engine into engine/ios cache
    # so any tool, script or compiler referencing engine/ios receives the 100% Release AOT framework.
    engine_cache_dir = File.expand_path(File.join(flutter_root, 'bin', 'cache', 'artifacts', 'engine'))
    ios_debug_framework = File.join(engine_cache_dir, 'ios', 'Flutter.xcframework')
    ios_release_framework = File.join(engine_cache_dir, 'ios-release', 'Flutter.xcframework')

    if Dir.exist?(ios_release_framework) && Dir.exist?(ios_debug_framework)
      puts '[Podfile] CI detected: Synchronizing Release AOT Flutter engine into engine/ios cache...'
      system("rm -rf '#{ios_debug_framework}' && cp -R '#{ios_release_framework}' '#{ios_debug_framework}'")
    end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Force iOS 15.0 deployment target across all pods
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Disable Bitcode (deprecated in Xcode 15+, legacy)
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Force code signing on all CocoaPods targets to avoid AMFI codesigning rejection on physical device
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'YES'

      if is_ci_build
        # Enforce Release engine search paths for all configurations on CI
        ['FRAMEWORK_SEARCH_PATHS', 'FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*]', 'FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*]'].each do |key|
          if config.build_settings[key]
            config.build_settings[key] = config.build_settings[key].gsub('/artifacts/engine/ios/', '/artifacts/engine/ios-release/')
          end
        end
      end
    end
  end

  # Force iOS 15.0 deployment target at the Pods project level
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
  end

  # Ensure all aggregate targets (such as Pods-Runner) also enforce iOS 15.0
  if installer.respond_to?(:aggregate_targets)
    installer.aggregate_targets.each do |target|
      if target.respond_to?(:xcconfigs)
        target.xcconfigs.each do |config_name, config_file|
          config_file.attributes['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

          if is_ci_build
            ['FRAMEWORK_SEARCH_PATHS', 'FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*]', 'FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*]'].each do |key|
              if config_file.attributes[key]
                config_file.attributes[key] = config_file.attributes[key].gsub('/artifacts/engine/ios/', '/artifacts/engine/ios-release/')
              end
            end
          end
        end
      end
    end
  end
end
# Set minimum platform version for Guido Companion App (Flutter + Unity UaaL)
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Auto-compilation helper for UnityFramework in CI/CD environments (Appcircle headless macOS runner)
def compile_unity_framework_if_needed
  framework_dir = File.expand_path("UnityLibrary/UnityFramework.framework", __dir__)
  binary_path = File.join(framework_dir, "UnityFramework")
  source_path = File.join(framework_dir, "UnityFramework.m")
  headers_path = File.join(framework_dir, "Headers")

  if File.exist?(source_path) && !File.exist?(binary_path)
    puts "=== [Guido CI Bridge] Compiling UnityFramework dynamic library for arm64 iOS ==="
    sdk_path = `xcrun --sdk iphoneos --show-sdk-path 2>/dev/null`.strip
    if sdk_path.empty?
      cmd = "xcrun --sdk iphoneos clang -target arm64-apple-ios15.0 -isysroot $(xcrun --sdk iphoneos --show-sdk-path) -I'#{headers_path}' -framework Foundation -framework UIKit -fobjc-arc -dynamiclib -install_name @rpath/UnityFramework.framework/UnityFramework -o '#{binary_path}' '#{source_path}'"
    else
      cmd = "xcrun --sdk iphoneos clang -target arm64-apple-ios15.0 -isysroot '#{sdk_path}' -I'#{headers_path}' -framework Foundation -framework UIKit -fobjc-arc -dynamiclib -install_name @rpath/UnityFramework.framework/UnityFramework -o '#{binary_path}' '#{source_path}'"
    end
    puts "Executing: #{cmd}"
    system(cmd)
    if File.exist?(binary_path)
      puts "=== [Guido CI Bridge] UnityFramework compiled successfully! (#{File.size(binary_path)} bytes) ==="
    else
      puts "=== [Guido CI Bridge] Notice: UnityFramework compilation skipped or pending macOS toolchain ==="
    end
  end
end

# Compile immediately when Podfile is evaluated
compile_unity_framework_if_needed

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

pre_install do |installer|
  compile_unity_framework_if_needed
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  compile_unity_framework_if_needed

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Force iOS 15.0 deployment target across all pods
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Disable Bitcode (deprecated in Xcode 15+, unsupported by modern UnityFramework)
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # Support UnityFramework search paths for flutter_unity_widget
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '"${PODS_ROOT}/../UnityLibrary"'
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '"${PODS_CONFIGURATION_BUILD_DIR}"'
    end
  end

  # Force iOS 15.0 deployment target at the Pods project level
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
  end

  # Ensure all aggregate targets (such as Pods-Runner) also enforce iOS 15.0
  if installer.respond_to?(:aggregate_targets)
    installer.aggregate_targets.each do |target|
      if target.respond_to?(:xcconfigs)
        target.xcconfigs.each do |config_name, config_file|
          config_file.attributes['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end
  end
end